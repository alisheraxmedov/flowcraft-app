# Flutter/Dart/Pub related
# Lockfiles regenerate on every `pod install` / SDK bump and are pure
# churn in a desktop-app repo without reproducible-build requirements.
/pubspec.lock
ios/Podfile.lock
macos/Podfile.lock
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/build/
# Packaging output from the desktop-installer CI (dmg/deb staging).
**/dist/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Symbolication / obfuscation output
app.*.symbols
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── Security: secrets, credentials, signing material ──────────────────────
